+            || printflow_paymongo_env('PAYMONGO_LIVE_SECRET_KEY') !== '';
+        if ($liveConfigurationPresent) {
             return '';
         }
-        return printflow_paymongo_secret_key_for_mode($mode) !== '' ? $mode : '';
+        if ($testReady) {
+            return 'test';
+        }
+        return $liveAllowed ? 'live' : '';
     }
 }
 
