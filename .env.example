# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payment receipt OCR
PAYMENT_OCR_PROVIDER=auto
PAYMENT_OCR_TESSERACT_PATH=
PAYMENT_OCR_TEMP_DIR=
PAYMENT_OCR_API_KEY=your_ocr_space_api_key
PAYMENT_OCR_API_URL=https://api.ocr.space/parse/image
PAYMENT_OCR_LANGUAGE=eng
PAYMENT_OCR_TIMEOUT_SECONDS=25

# PayMongo test credentials; keep real values in public_html/.env on production
PAYMONGO_MODE=test
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_API_URL=https://api.paymongo.com
