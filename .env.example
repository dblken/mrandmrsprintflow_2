# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payment receipt OCR
PAYMENT_OCR_PROVIDER=auto
PAYMENT_OCR_TESSERACT_PATH=
PAYMENT_OCR_TEMP_DIR=
PAYMENT_OCR_API_KEY=your_ocr_space_api_key
PAYMENT_OCR_API_URL=https://api.ocr.space/parse/image
PAYMENT_OCR_LANGUAGE=eng
PAYMENT_OCR_TIMEOUT_SECONDS=25

# PayMongo credentials; keep real values in public_html/.env on production.
# Live link creation remains fail-closed until explicitly enabled.
ONLINE_PAYMENT_MODE=paymongo
PAYMONGO_MODE=test
PAYMONGO_API_URL=https://api.paymongo.com
PAYMONGO_TEST_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_TEST_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_TEST_WEBHOOK_SECRET=whsk_your_test_webhook_secret
PAYMONGO_TEST_DIRECT_METHODS=qrph
PAYMONGO_LIVE_ENABLED=false
PAYMONGO_LIVE_PUBLIC_KEY=pk_live_your_public_key
PAYMONGO_LIVE_SECRET_KEY=sk_live_your_secret_key
PAYMONGO_LIVE_WEBHOOK_SECRET=whsk_your_live_webhook_secret
# Add qrph only after PayMongo confirms it is enabled for the live merchant.
PAYMONGO_LIVE_DIRECT_METHODS=

# PushPrinter v3.1.0 uses Pushy to notify the Windows agent about queued jobs.
# Create a Pushy app, put its Secret API Key here, and configure the matching
# App ID plus this site's base URL in the Windows PushPrinter config.
PUSHY_API_SECRET=your_pushy_secret_api_key

# Temporarily hide and reject legacy manual GCash proof submissions.
MANUAL_PAYMENT_ENABLED=false

# Database (DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD are also supported)
PRINTFLOW_DB_HOST=localhost
PRINTFLOW_DB_PORT=3306
PRINTFLOW_DB_NAME=printflow
PRINTFLOW_DB_USER=printflow_app
PRINTFLOW_DB_PASS=use_a_non_empty_local_password
